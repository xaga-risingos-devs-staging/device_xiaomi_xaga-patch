From a2be4e78bdb8ef489da151e75780900d5ee1df09 Mon Sep 17 00:00:00 2001
From: Hecheng Yu <kde-yyds@qq.com>
Date: Fri, 22 Aug 2025 21:57:01 +0800
Subject: [PATCH 2/2] More touch power hints

---
 .../com/android/server/wm/DisplayPolicy.java  | 42 +++++++++++++------
 1 file changed, 30 insertions(+), 12 deletions(-)

diff --git a/services/core/java/com/android/server/wm/DisplayPolicy.java b/services/core/java/com/android/server/wm/DisplayPolicy.java
index ced2a90a2..ea9d1c2e3 100644
--- a/services/core/java/com/android/server/wm/DisplayPolicy.java
+++ b/services/core/java/com/android/server/wm/DisplayPolicy.java
@@ -666,14 +666,23 @@ public class DisplayPolicy {
                     if(mOldMtkPerf != null) {
                         try {
                             android.util.Log.d("PHH-Power", "mtk1 fling power hint");
-                            int hint = 36; // MTKPOWER_HINT_APP_TOUCH
-                            if("rotate".equals(SystemProperties.get("persist.sys.phh.touch_hint")))
-                                    hint = 35; // MTKPOWER_HINT_APP_ROTATE
-                            mOldMtkPerf.mtkPowerHint(hint, duration);
+                            int hint = 38;
+                            mOldMtkPerf.mtkPowerHint(hint, duration * 4);
                         } catch(Throwable t) {
                             android.util.Log.d("PHH-Power", "Failed sending touch power hint", t);
                         }
                     }
+                    // Primary boost for touch interactions
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.INTERACTION, duration * 4);
+
+                    // Additional boost for display updates
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.DISPLAY_UPDATE_IMMINENT, duration * 4);
+
+                    // Try ML_ACC boost (might help GPU on some devices)
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.ML_ACC, duration * 4);
+
+                    // Additional boost for camera launch, which is aggressive
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.CAMERA_LAUNCH, duration * 4);
                 }
 
                 @Override
@@ -695,10 +704,8 @@ public class DisplayPolicy {
                     if(mMtkPerf != null) {
                         try {
                             android.util.Log.d("PHH-Power", "mtk power hint");
-                            int hint = 25; //MTKPOWER_HINT_APP_TOUCH
-                            if("rotate".equals(SystemProperties.get("persist.sys.phh.touch_hint")))
-                                    hint = 24; // MTKPOWER_HINT_APP_ROTATE
-                            mMtkPerf.perfCusLockHint(hint, 1000);
+                            int hint = 24; // MTKPOWER_HINT_APP_ROTATE
+                            mMtkPerf.perfCusLockHint(hint, 2000);
                         } catch(Throwable t) {
                             android.util.Log.d("PHH-Power", "Failed sending touch power hint", t);
                         }
@@ -706,14 +713,25 @@ public class DisplayPolicy {
                     if(mOldMtkPerf != null) {
                         try {
                             android.util.Log.d("PHH-Power", "mtk1 power hint");
-                            int hint = 36; // MTKPOWER_HINT_APP_TOUCH
-                            if("rotate".equals(SystemProperties.get("persist.sys.phh.touch_hint")))
-                                    hint = 35; // MTKPOWER_HINT_APP_ROTATE
-                            mOldMtkPerf.mtkPowerHint(hint, 1000);
+                            int hint = 38;
+                            mOldMtkPerf.mtkPowerHint(hint, 2000);
                         } catch(Throwable t) {
                             android.util.Log.d("PHH-Power", "Failed sending touch power hint", t);
                         }
                     }
+
+                    int duration = 2000;
+                    // Primary boost for touch interactions
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.INTERACTION, duration);
+
+                    // Additional boost for display updates
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.DISPLAY_UPDATE_IMMINENT, duration);
+
+                    // Try ML_ACC boost (might help GPU on some devices)
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.ML_ACC, duration);
+
+                    // Additional boost for camera launch, which is aggressive
+                    mService.mPowerManagerInternal.setPowerBoost(Boost.CAMERA_LAUNCH, duration);
                 }
 
